# MiniMexitas Website Environment Configuration
# Copy this file to .env and fill in your values.

# Django Settings
SECRET_KEY=your-random-production-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,pemujo.pythonanywhere.com

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional explicit redirect URI (useful if behind HTTPS reverse proxy):
# GOOGLE_OAUTH_REDIRECT_URI=https://pemujo.pythonanywhere.com/auth/callback/

# Google Service Account (Sheets Sync via .env)
# Option A: Single-line minified JSON string of the service account
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Option B: Individual environment variables
# GOOGLE_SA_PROJECT_ID=minimexas
# GOOGLE_SA_CLIENT_EMAIL=sheets@minimexas.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SA_PRIVATE_KEY_ID=...
# GOOGLE_SA_CLIENT_ID=...

# Target Google Spreadsheet Key / ID (Allows separate spreadsheets for Staging vs Production)
# Obtain from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_KEY>/edit
GOOGLE_SHEET_KEY=your-target-google-spreadsheet-id-here

# Note: Admin / Organizer privileges are managed directly via the 'Role' column in the Google Sheet 'Members' tab.

# Portal Public URL (used in email and WhatsApp notifications)
PORTAL_BASE_URL=https://your-domain.pythonanywhere.com

# Email Notifications (for sending approval welcome emails)
# In development/DEBUG=True, emails are printed to the console backend by default.
# For production (e.g. Gmail SMTP or SendGrid/Amazon SES):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=user@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MiniMexitas Community 

